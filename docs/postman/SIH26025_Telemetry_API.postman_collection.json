    {
      "name": "08. Ingestion - Valid Telemetry Batch",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{api_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"node_code\": \"SN-102\",\n  \"timestamp\": \"2026-09-21T12:30:00Z\",\n  \"battery_pct\": 94.2,\n  \"rssi_dbm\": -72,\n  \"readings\": [\n    { \"channel\": \"TILT_X\", \"value\": 1.45, \"unit\": \"arcsec\" },\n    { \"channel\": \"TILT_Y\", \"value\": -0.82, \"unit\": \"arcsec\" },\n    { \"channel\": \"DISP_Z\", \"value\": 18.24, \"unit\": \"mm\" },\n    { \"channel\": \"VIB_RMS\", \"value\": 0.12, \"unit\": \"mm/s\" },\n    { \"channel\": \"STRAIN\", \"value\": 418.0, \"unit\": \"µε\" }\n  ]\n}"

{
  "info": {
    "name": "SIH26025 Telemetry Ingestion API Test Suite",
    "_postman_id": "c7a8b412-e89a-4c22-9f3b-1b2602500001",
    "description": "Comprehensive test suite for SIH26025 Edge Hardware Telemetry Ingestion Endpoint (`POST /api/telemetry/ingest`). Validates authentication, schema enforcement, rate limiting, and duplicate detection under DGMS guidelines.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "sih26025-edge-telemetry-secret-key",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Auth - Missing API Key",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"node_code\": \"SN-101\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/telemetry/ingest",
          "host": ["{{base_url}}"],
          "path": ["api", "telemetry", "ingest"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Error code is UNAUTHORIZED', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code).to.eql('UNAUTHORIZED');",
              "});"
            ]
          }
        }
      ]
    },
    {

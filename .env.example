# ==============================================================================
# SIH26025 Production & Deployment Environment Variables
# ==============================================================================
# SMART INDIA HACKATHON 2026 — Ministry of Coal
# Problem Statement: AI-Enabled Low-Cost Real-Time Mine Subsidence Monitoring
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Authentication Configuration
# ------------------------------------------------------------------------------
# Public Supabase URL (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anonymous Key (safe for browser exposure, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-Only Supabase Service Role Key
# CRITICAL: NEVER expose this key to browser bundles, client components, or commits!
# Only used for privileged backend batch syncing or administrative DB seeding.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-browser

# ------------------------------------------------------------------------------
# 2. Edge Microcontroller & Gateway Telemetry Authentication
# ------------------------------------------------------------------------------
# Shared secret API key used by ESP32 microcontrollers and LoRaWAN gateways
# to authenticate HTTP POST requests to /api/telemetry/ingest via 'x-api-key' header.
TELEMETRY_API_KEY=sih26025-edge-telemetry-secret-key

# ------------------------------------------------------------------------------
# 3. Application Runtime Configuration
# ------------------------------------------------------------------------------
# Environment flag: 'development' | 'production' | 'test'
NEXT_PUBLIC_APP_ENV=production

# Canonical deployment base URL (used for auth redirect callbacks and webhook URLs)
NEXT_PUBLIC_SITE_URL=https://mineguard-sih26025.vercel.app

# Optional: Default Simulation Mode ('DEMO' | 'LIVE')
NEXT_PUBLIC_DEFAULT_TELEMETRY_MODE=DEMO

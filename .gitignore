# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Next.js Build Outputs
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
